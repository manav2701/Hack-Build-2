# Voice agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_demo123
ELEVENLABS_API_KEY=sk_elevenlabs_demo

# Backend. A localhost value is ignored in a deployed build (see lib/api.ts) — it only
# applies when the page is itself served from localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match DALAL_SECRET_KEY on the API if you set a non-default one.
NEXT_PUBLIC_DALAL_KEY=dalal-secret-123

# Supabase is no longer used by the web app. The realtime subscription was removed in
# favour of polling; accounts live in the API's own store.
