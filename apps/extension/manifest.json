{
  "manifest_version": 3,
  "name": "DaleelBites — UAE Food Broker",
  "version": "1.1.0",
  "description": "Speak a craving. DaleelBites compares it live across Talabat, Deliveroo and Noon Food, then takes you to the order page.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open DaleelBites",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "host_permissions": [
    "https://hack-build-2-production.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.talabat.com/*",
        "https://talabat.com/*",
        "https://deliveroo.ae/*",
        "https://food.noon.com/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
